app:
  name: "GoCommerce"
  port: "8080"

postgres:
  host: "localhost"
  port: "5432"
  user: "postgres"
  pass: "your_password_here"
  db: "gocommerce"
  sslmode: "disable"
  auto_migrate: true
  max_open_conns: 25
  max_idle_conns: 10
  conn_max_lifetime: "5m"
  conn_max_idle_time: "1m"

log:
  level: "info"

redis:
  address: "localhost:6379"
  pass: ""
  db: 0
  dial_timeout: "5s"

auth:
  otp_ttl: "10m"
  signup_rate_limit:
    max_per_hour: 3
    max_per_day: 6
    window_hour: "1h"
    window_day: "24h"
  login_rate_limit:
    max_attempts: 5
    lockout_time: "15m"
  resend_cooldown: "60s"
  max_resend_per_session: 3

jwt:
  secret: "your-super-secret-key-min-32-chars-long"
  access_expiry: "15m"
  refresh_expiry: "168h"
  issuer: "gocommerce"

smtp:
  host: "smtp.gmail.com"
  port: 587
  username: "your_email@gmail.com"
  password: "your_16_digit_app_password"
  from_address: "your_email@gmail.com"
  from_name: "GoCommerce"
  tls_mode: "STARTTLS"
  timeout: "10s"
